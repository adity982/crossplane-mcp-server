{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ravibagri5/crossplane-mcp-server",
  "title": "Crossplane",
  "description": "Read-only access to a Crossplane control plane: resources, claims, packages, compositions.",
  "websiteUrl": "https://github.com/ravibagri5/crossplane-mcp-server",
  "repository": {
    "url": "https://github.com/ravibagri5/crossplane-mcp-server",
    "source": "github"
  },
  "version": "0.1.5",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/ravibagri5/crossplane-mcp-server:0.1.5",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-v",
          "value": "{kubeconfig_path}:/home/nonroot/.kube:ro",
          "description": "Mount your kubeconfig directory into the container",
          "isRequired": true,
          "variables": {
            "kubeconfig_path": {
              "description": "Absolute path to your .kube directory",
              "default": "${HOME}/.kube",
              "isRequired": true
            }
          }
        }
      ]
    }
  ]
}
