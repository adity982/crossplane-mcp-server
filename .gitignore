# Build output
/bin/
/dist/
/out/

# `go build ./cmd/crossplane-mcp-server` drops the binary in the working
# directory rather than in bin/, so ignore it by name at the repo root.
/crossplane-mcp-server
/crossplane-mcp-server.exe

# Compiled objects and archives
*.exe
*.exe~
*.dll
*.so
*.dylib
*.a
*.o

# Test binaries and coverage
*.test
coverage.out
coverage.html
coverage.txt
*.cover
*.coverprofile

# Profiling and debugger output
*.prof
cpu.out
mem.out
trace.out
__debug_bin*

# Go workspace files, which are personal to a checkout
go.work
go.work.sum

# Dependency directories. We do not vendor, so its presence is a mistake.
/vendor/
node_modules/

# Credentials and cluster configuration. Nothing here is ever committed.
.env
.env.*
!.env.example
kubeconfig
*.kubeconfig
*.pem
*.key
*.crt
*.p12
*.pfx

# Logs and scratch files
*.log
*.tmp
*.bak
*.orig
*.rej
tmp/

# Editors and IDEs
.idea/
*.iml
*.swp
*.swo
*~
.vscode/*
# Kept because it shows contributors how to run this server from VS Code.
!.vscode/mcp.json
!.vscode/extensions.json

# Operating system noise
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
